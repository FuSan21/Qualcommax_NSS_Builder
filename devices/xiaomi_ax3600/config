#
# Xiaomi AX3600 (IPQ8071A, 512 MB) — the reference build.
#
# Concatenated onto devices/common/config by prepare-build.sh.
#

CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

# 512 MB board: the ath11k profile is also forced by kmod-ath11k's NSS block,
# and the NSS MEDIUM profile replaces the ipq807x default (HIGH), which does
# not fit here.
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

CONFIG_ATH10K-CT_LEDS=n
CONFIG_PACKAGE_ath10k-board-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=n

## Hardware this board does not have.
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-xhci-hcd=n
CONFIG_PACKAGE_kmod-usb3=n

# CONFIG_USE_MKLIBS is not set

## DNS - use dnsmasq-full instead of the stripped default
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

## Shell and system utilities
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bmon=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-realpath=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_unzip=y

## Networking tools
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-nft=y

## Kernel modules - tunnels and advanced routing
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-pppol2tp=y
CONFIG_PACKAGE_kmod-pptp=y
CONFIG_PACKAGE_kmod-sched-connmark=y

## WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## Multi-WAN
CONFIG_PACKAGE_luci-app-mwan3=y

## Statistics / Monitoring
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y
CONFIG_PACKAGE_luci-app-statistics=y

## nginx as LuCI web server
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_nginx-mod-luci=y
CONFIG_PACKAGE_nginx-mod-ubus=y
CONFIG_PACKAGE_nginx-ssl-util=y

## ACME / Let's Encrypt
CONFIG_PACKAGE_acme-acmesh=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
CONFIG_PACKAGE_luci-app-acme=y

## LuCI extras
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-dashboard=y
